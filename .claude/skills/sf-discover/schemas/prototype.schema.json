{
  "$comment": "prototype.json: descrição declarativa de um protótipo clicável (renderizado em HTML autocontido com SLDS). Dados SEMPRE fictícios.",
  "type": "object",
  "required": ["schema", "title", "stories", "screens", "start"],
  "properties": {
    "schema": { "const": "1.0" },
    "title": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string" },
    "stories": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^US-\\d{3}$" } },
    "brief": { "type": "object", "description": "respostas da entrevista com a PO (prototype_brief)", "properties": { "audience": { "type": "string" }, "fidelity": { "type": "string" }, "scenarios": { "type": "string" } } },
    "app": { "type": "object", "properties": { "mode": { "enum": ["console", "simples"] }, "name": { "type": "string" }, "tabs": { "type": "array", "items": { "type": "string" } } } },
    "start": { "type": "string" },
    "screens": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "title", "blocks"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "layout": { "enum": ["pagina", "registro", "duas-colunas"] },
          "note": { "type": "string" },
          "blocks": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["type"], "properties": { "type": { "enum": ["heading", "text", "alert", "path", "fields", "form", "table", "cards", "actions", "tabs", "timeline", "highlights"] } } } }
        }
      }
    },
    "walkthrough": {
      "type": "array", "description": "roteiro de validação: cada passo cobre um cenário de aceite",
      "items": { "type": "object", "required": ["screen", "text"], "properties": { "screen": { "type": "string" }, "text": { "type": "string" }, "covers": { "type": "array", "items": { "type": "string", "pattern": "^US-\\d{3}#\\d+$" } } } }
    }
  }
}
